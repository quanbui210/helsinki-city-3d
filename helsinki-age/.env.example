# Server-only secret. Copy to .env.local in the project root; never use VITE_ here.
BRAVE_SEARCH_API_KEY=
# Enable only with a Brave subscription that grants search-result storage rights.
# true enables a bounded 24-hour in-memory cache (cleared on server restart).
BRAVE_STORAGE_ALLOWED=false
# Maximum address lookups per server per 24 hours; each costs up to five searches.
LISTING_DAILY_LIMIT=100
PORT=3000
